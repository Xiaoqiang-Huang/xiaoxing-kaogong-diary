APP_ENV=development
FLASK_DEBUG=true
HOST=0.0.0.0
PORT=5000

# 必须自己生成，不能提交真实值。生产环境必须设置。
SECRET_KEY=replace-with-a-random-secret

# AI配置可留空；留空时进入规则/模拟降级模式。
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=

# 可选：服务器端语音转文字兜底。浏览器语音识别不稳定时使用。
# 可接 OpenAI 官方接口，也可接 OpenAI 兼容的免费开源自托管服务：
# - speaches: https://github.com/speaches-ai/speaches
# - faster-whisper-server: https://github.com/etalab-ia/faster-whisper-server
SPEECH_TO_TEXT_PROVIDER=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe

# 本机 faster-whisper-server 示例：
# SPEECH_TO_TEXT_PROVIDER=openai
# OPENAI_API_KEY=local-key-can-be-any-non-empty-value
# OPENAI_BASE_URL=http://127.0.0.1:8000/v1
# OPENAI_TRANSCRIBE_MODEL=Systran/faster-whisper-small

# 本地首次启动如需自动创建账号，显式打开并设置密码。
CREATE_DEFAULT_USER=false
DEFAULT_USERNAME=demo
DEFAULT_PASSWORD=

# 上传限制，单位 MB。
MAX_CONTENT_LENGTH_MB=16

# 公网访问安全开关。使用内网穿透时建议开启，并关闭公开注册。
PUBLIC_ACCESS=false
ALLOW_PUBLIC_REGISTRATION=true
REGISTRATION_INVITE_CODE=
LOGIN_MAX_ATTEMPTS=8
LOGIN_RATE_LIMIT_SECONDS=300
REGISTER_MAX_ATTEMPTS=6
REGISTER_RATE_LIMIT_SECONDS=600
SESSION_COOKIE_SECURE=false
